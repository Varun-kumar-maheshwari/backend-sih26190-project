generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INVESTIGATOR
  FORENSIC_EXPERT
  COURT_CLERK
}

enum Rank {
  CONSTABLE
  SUB_INSPECTOR
  INSPECTOR
  DSP
  SP
  CIVILIAN_EXPERT
}

enum Department {
  GENERAL_DUTY
  CYBER_CELL
  NARCOTICS
  HOMICIDE
  ECONOMIC_OFFENCES
  FORENSICS_LAB
}

enum AuditAction {
  UPLOAD
  VIEW
  DELETE
  SHARE
  REDACT
  RETRY_REDACT
  GENERATE_BSA_CERT
}

enum DocumentStatus {
  REDACTED
  PENDING_REDACTION
  FAILED
}

enum DocumentType {
  FIR_COPY
  WITNESS_STATEMENT
  SEIZURE_MEMO
  FORENSIC_REPORT
  CHARGE_SHEET
  OTHER
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  CLOSED
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  name         String

  // RBAC and Hierarchy
  role       Role
  rank       Rank       @default(SUB_INSPECTOR)
  isSHO      Boolean    @default(false)
  department Department

  // Jurisdiction bounds
  state         String
  district      String
  policeStation String

  refreshToken String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  ledCases      Cases[]         @relation("CaseLeader")
  assignedCases Cases[]         @relation("CaseAssignments")
  documents     Documents[]
  auditLogs     Audit_Logs[]
  secureShares  Secure_Shares[]
}

model Cases {
  id          String     @id @default(uuid())
  caseNumber  String     @unique
  title       String
  description String?
  status      CaseStatus

  // Jurisdiction bounds
  state         String
  district      String
  policeStation String

  // Ownership and Collaboration
  leadInvestigator String
  user             User   @relation("CaseLeader", fields: [leadInvestigator], references: [id])
  assignedOfficers User[] @relation("CaseAssignments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  documents Documents[]
}

model Documents {
  id                String       @id @default(uuid())
  title             String
  documentReference String?
  type              DocumentType

  caseId String
  case   Cases  @relation(fields: [caseId], references: [id])

  uploaderId String
  userId     User   @relation(fields: [uploaderId], references: [id])

  originalFilePath String
  redactedFilePath String?
  fileHash         String
  idempotencyKey   String  @unique

  // AI and Metadata
  extractedText  String? @db.Text
  classifiedData Json? // Stores NLP output (BNS mappings, entities)
  deviceMetaData Json    @default("{}")

  status    DocumentStatus @default(PENDING_REDACTION)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Relationships
  auditLogs    Audit_Logs[]
  secureShares Secure_Shares[]
}

model Audit_Logs {
  id           String      @id @default(uuid())
  documentId   String
  document     Documents   @relation(fields: [documentId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  previousHash String?
  currentHash  String
  timeStamp    DateTime    @default(now())
  action       AuditAction
}

model Secure_Shares {
  id           String    @id @default(uuid())
  document     Documents @relation(fields: [documentId], references: [id])
  documentId   String
  user         User      @relation(fields: [createdBy], references: [id])
  createdBy    String
  targetEmail  String
  maxViews     Int
  currentViews Int       @default(0)
  isActive     Boolean   @default(true)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
